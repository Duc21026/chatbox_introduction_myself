CHATBOT_ANSWER_MODEL=qwen2.5:7b
CHATBOT_EMBEDDING_MODEL=bge-m3
CHATBOT_RELEVANCE_THRESHOLD=1.0
CHATBOT_FUZZY_CUTOFF=80
CHATBOT_DATA_DIR=backend/data
CHATBOT_QA_PATH=backend/qa.txt
CHATBOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
CHATBOT_CHUNK_SIZE=500
CHATBOT_CHUNK_OVERLAP=50
CHATBOT_TOP_K=3
CHATBOT_QUERY_REWRITE=off
CHATBOT_QUERY_CACHE_SIZE=512

# KB Engine / tiered responses
CHATBOT_KB_PATH=backend/kb.json
CHATBOT_KB_HIGH_THRESHOLD=0.78
CHATBOT_SUGGEST_THRESHOLD=0.45
CHATBOT_DOC_THRESHOLD=0.55
CHATBOT_AMBIGUITY_GAP=0.05
CHATBOT_MAX_SUGGESTIONS=4
CHATBOT_KB_MAX_SUGGESTIONS=4

# Document index
CHATBOT_DOC_INDEX_DIR=backend/doc_index
CHATBOT_DOC_MAX_BYTES=20971520

# Session state
CHATBOT_SESSION_TTL=1800
CHATBOT_SESSION_MAX=1000

# Optional LLM summary (off by default)
ENABLE_LLM_SUMMARY=false
CHATBOT_RATE_LIMIT=60/minute
